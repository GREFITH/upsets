APP_ENV=development
# CORS: default relaxed (any origin, no cookies) so Railway frontends work without exact Origin match.
# Set APP_CORS_STRICT=true to lock down — then set APP_CORS_ORIGINS and optionally APP_CORS_ORIGIN_REGEX.
# APP_CORS_STRICT=false
# Comma-separated browser origins (used only when APP_CORS_STRICT=true):
# APP_CORS_ORIGINS=http://localhost:8080,https://frontend-production-xxxx.up.railway.app
# Optional regex when strict (e.g. all Railway HTTPS previews): APP_CORS_ORIGIN_REGEX=https://.*\.up\.railway\.app
APP_CORS_ORIGINS=http://localhost:8080

# Optional — not read by current Backend code (Postgres is via DATABASE_URL only).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<supabase_anon_key>
# SUPABASE_SERVICE_ROLE_KEY=<optional_for_future_features>

# Use the password from Supabase → Settings → Database. Host MUST match the project:
# - Direct (simple): postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Use the transaction pooler (port 6543 / hostname contains "pooler") only if you need it.
# The backend uses NullPool + disables asyncpg/SQLAlchemy prepared-statement caches for known pooler hosts
# (Supabase, Neon, :6543, etc.) and unique statement names to avoid DuplicatePreparedStatementError with PgBouncer.
# If you still see that error, set DATABASE_PGBOUNCER_COMPAT=true. For the fewest surprises in local dev,
# prefer direct session mode: db.<project-ref>.supabase.co:5432 (see Supabase → Connect).
# DATABASE_PGBOUNCER_COMPAT=false
# Wrong password → asyncpg InvalidPasswordError, APIs return empty data or 500, Harvest sync fails.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Default true: uses certifi CA bundle (fixes macOS SSLCertVerificationError to Supabase).
# Only if you are behind TLS interception and still fail: DATABASE_SSL_VERIFY=false
DATABASE_SSL_VERIFY=true
# Postgres statement_timeout in milliseconds for pooled connections (Harvest sync can run many minutes).
# Set DATABASE_STATEMENT_TIMEOUT_MS=0 to omit and use Supabase defaults.
DATABASE_STATEMENT_TIMEOUT_MS=1800000

HARVEST_TOKEN=<harvest_pat>
HARVEST_ACCOUNT_ID=<harvest_account_id>
HARVEST_USER_AGENT_EMAIL=<email_for_user_agent>
# First Harvest sync / full time resync — time entries only (directory phases unchanged):
# - Work-day filter (Harvest ``spent_date`` via API ``from`` / ``to``) — use this for “hours from May 1 onward”:
#   HARVEST_INITIAL_SYNC_TIME_ENTRIES_SPENT_FROM=2026-05-01
#   # optional upper bound:
#   # HARVEST_INITIAL_SYNC_TIME_ENTRIES_SPENT_TO=2026-05-31
# - “Last modified in Harvest” window (NOT work day): overrides DAYS when set; ignored for time entries if SPENT_FROM is set.
#   # HARVEST_INITIAL_SYNC_TIME_ENTRIES_UPDATED_SINCE=2024-01-01
# - Rolling lookback when neither SPENT_FROM nor UPDATED_SINCE is set. Use 0 for unlimited (slow).
HARVEST_INITIAL_SYNC_TIME_ENTRIES_DAYS=548
# Optional: per-request timeout to Harvest API in seconds (default 120).
# HARVEST_HTTP_TIMEOUT_SECONDS=120

# Performance optimizations (recommended for faster syncs):
# Only sync active projects/clients/users (default true). Set to false to include archived/inactive records.
HARVEST_SYNC_ACTIVE_ONLY=true
