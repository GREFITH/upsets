# Backend origin (scheme required for local; on Railway you may use host only — the client prepends https://).
# Examples:
#   VITE_API_BASE_URL=http://127.0.0.1:8000
#   VITE_API_BASE_URL=https://backend-production-xxxx.up.railway.app
#   VITE_API_BASE_URL=backend-production-xxxx.up.railway.app
VITE_API_BASE_URL=http://127.0.0.1:8000
